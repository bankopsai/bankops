{
  "name": "bankops",
  "version": "0.1.0",
  "description": "Deck engine for AI agents: turn deck JSON into investment-banking-grade PPTX. 12-column grid layout, native charts, text-fit budgets. Free for noncommercial use; commercial license required.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js" },
    "./package.json": "./package.json"
  },
  "bin": { "bankops": "dist/cli/bankops.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "cli": "node --import tsx src/cli/bankops.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.5",
    "echarts": "^6.0.0",
    "jszip": "^3.10.1",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "pptxgenjs": { "optional": true },
    "sharp": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "files": ["dist", "skill", "examples", "README.md", "LICENSE", "COMMERCIAL-LICENSE.md"],
  "keywords": ["pptx", "powerpoint", "presentation", "slides", "investment-banking", "pitch-deck", "ai-agents", "mcp", "deck", "charts"],
  "repository": { "type": "git", "url": "git+https://github.com/bankops-ai/bankops.git" },
  "homepage": "https://bankops.ai"
}
